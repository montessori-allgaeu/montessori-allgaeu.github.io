{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["vitest/globals"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "dist-admin",
    ".wrangler",
    "worker",
    "vitest.worker.config.ts",
    "playwright-report",
    "test-results",
    "artifacts",
    "tmp"
  ]
}
