---
import { Image } from "astro:assets";
import officialLogo from "@/assets/brand/official/logo-montessori-allgaeu-ab-2022.png";

interface Props {
  inverted?: boolean;
  compact?: boolean;
  loading?: "eager" | "lazy";
}

const { inverted = false, compact = false, loading = "eager" } = Astro.props;
const sizes = compact ? "192px" : inverted ? "264px" : "248px";
---

<a
  class:list={["brand", { "brand--inverted": inverted, "brand--compact": compact }]}
  href="/"
  aria-label="Montessori Allgäu – Schule & Kindergarten – Startseite"
>
  <Image
    class="brand__logo"
    src={officialLogo}
    alt=""
    width={638}
    height={135}
    widths={[320, 480, 638]}
    {sizes}
    {loading}
  />
</a>

<style>
  .brand {
    display: inline-block;
    width: min(15.5rem, 100%);
    min-width: 0;
    line-height: 0;
    text-decoration: none;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand__logo {
    width: 100%;
    height: auto;
  }

  .brand--compact {
    width: min(12rem, 100%);
  }

  .brand--inverted {
    width: min(16.5rem, 100%);
  }
</style>
