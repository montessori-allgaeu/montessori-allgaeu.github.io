---
import "@/styles/global.css";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { getBreadcrumbItems } from "@/data/breadcrumbs";
import { getWebsiteSettings } from "@/data/content";
import { site } from "@/data/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  breadcrumbLabel?: string;
  primaryImage?: string;
  primaryImageAlt?: string;
  primaryImageWidth?: number;
  primaryImageHeight?: number;
  noindex?: boolean;
  canonicalPath?: string;
  additionalStructuredData?: Record<string, unknown>[];
}

const {
  title,
  description,
  image = "/social-card-montessori-allgaeu.jpg",
  imageAlt = "Drei Kinder arbeiten mit Stellenwertkarten und goldenem Montessori-Perlenmaterial; im Hintergrund liegt eine Tausenderkette. Daneben steht Montessori Allgäu – Kindergarten & Schule in Oberstaufen.",
  breadcrumbLabel = title,
  primaryImage = image,
  primaryImageAlt = imageAlt,
  primaryImageWidth = 1200,
  primaryImageHeight = 630,
  noindex = false,
  canonicalPath,
  additionalStructuredData = [],
} = Astro.props;
const { contact } = await getWebsiteSettings();

const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site.url);
const socialImage = new URL(image, site.url);
const pagePrimaryImage = new URL(primaryImage, site.url);
const logo = new URL("/favicon.png", site.url);
const organizationId = new URL("/#organization", site.url);
const websiteId = new URL("/#website", site.url);
const webpageId = new URL(`${canonical.pathname}#webpage`, site.url);
const imageId = new URL(`${pagePrimaryImage.pathname}#primaryimage`, site.url);
const breadcrumbId = new URL(`${canonical.pathname}#breadcrumb`, site.url);
const isCanonicalPage = canonical.pathname === Astro.url.pathname;
const breadcrumbItems =
  !noindex && isCanonicalPage ? getBreadcrumbItems(Astro.url.pathname, breadcrumbLabel) : [];
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["School", "Preschool"],
      "@id": organizationId,
      name: "Montessori Allgäu – Kindergarten & Schule",
      alternateName: site.name,
      description:
        "Montessori-Kindergarten und Schule in Oberstaufen vom Kindergarten bis zur 10. Klasse.",
      url: site.url,
      logo: {
        "@type": "ImageObject",
        url: logo,
        width: 512,
        height: 512,
      },
      image: { "@id": imageId },
      email: contact.email,
      telephone: contact.phoneHref,
      address: {
        "@type": "PostalAddress",
        streetAddress: contact.address.street,
        postalCode: contact.address.postalCode,
        addressLocality: contact.address.locality,
        addressCountry: "DE",
      },
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: site.url,
      name: site.name,
      description: "Montessori-Kindergarten und Schule in Oberstaufen",
      inLanguage: "de-DE",
      publisher: { "@id": organizationId },
    },
    {
      "@type": "ImageObject",
      "@id": imageId,
      url: pagePrimaryImage,
      contentUrl: pagePrimaryImage,
      width: primaryImageWidth,
      height: primaryImageHeight,
      caption: primaryImageAlt,
    },
    {
      "@type": "WebPage",
      "@id": webpageId,
      url: canonical,
      name: pageTitle,
      description,
      inLanguage: "de-DE",
      isPartOf: { "@id": websiteId },
      about: { "@id": organizationId },
      primaryImageOfPage: { "@id": imageId },
      ...(breadcrumbItems.length > 0 && { breadcrumb: { "@id": breadcrumbId } }),
    },
    ...(breadcrumbItems.length > 0
      ? [
          {
            "@type": "BreadcrumbList",
            "@id": breadcrumbId,
            itemListElement: breadcrumbItems.map((item, index) => ({
              "@type": "ListItem",
              position: index + 1,
              name: item.name,
              item: new URL(item.href, site.url),
            })),
          },
        ]
      : []),
    ...additionalStructuredData,
  ],
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f5f1ec" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de-DE" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <Header />
    <main id="main-content">
      {breadcrumbItems.length > 0 && <Breadcrumbs items={breadcrumbItems} />}
      <slot />
    </main>
    <Footer />
  </body>
</html>
