---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import HubLink from "@/components/HubLink.astro";
import ImageSplit from "@/components/ImageSplit.astro";
import CTASection from "@/components/CTASection.astro";
import TextLink from "@/components/TextLink.astro";
import NextIntroductionEvent from "@/components/NextIntroductionEvent.astro";
import { getEvents } from "@/data/content";
import { getSeoLayoutProps, seoPages } from "@/data/seo";

const events = await getEvents();
---

<BaseLayout {...getSeoLayoutProps(seoPages.kennenlernen)}>
  <PageIntro
    eyebrow="Monte kennenlernen"
    title="Findet heraus, ob die Monte zu euch passt."
    intro="Wir möchten euch kennenlernen – und ihr sollt erleben, wie wir arbeiten. Gemeinsam finden wir heraus, ob euer Kind, eure Familie und die Monte gut zusammenpassen."
    compact
  >
    <nav class="introduction-links" aria-label="Aufnahme und Kosten">
      <TextLink href="/kennenlernen/aufnahme-kindergarten/" label="Aufnahme Kindergarten" />
      <TextLink href="/kennenlernen/aufnahme-schule/" label="Aufnahme Schule" />
      <TextLink href="/kennenlernen/kosten/" label="Kosten & Mitarbeit" />
    </nav>
    <NextIntroductionEvent events={events} />
  </PageIntro>

  <section class="section">
    <div class="container grid-2 fit-columns">
      <article>
        <p class="eyebrow">Entwicklung ermöglichen</p>
        <h2>Wann passen wir gut zusammen?</h2>
        <ul class="editorial-list">
          <li>Ihr wollt bewusst zu Montessori – nicht nur weg von einer Regelschule.</li>
          <li>Ihr traut eurem Kind zu, Interessen und ein eigenes Tempo zu entwickeln.</li>
          <li>
            Ihr wollt einen Weg, der nicht über Noten, Druck oder eine fixe Regelschulzeit gesteuert
            wird.
          </li>
          <li>Ihr seid bereit, offen zu sprechen, Rückmeldung anzunehmen und aktiv mitzumachen.</li>
        </ul>
      </article>
      <article>
        <p class="eyebrow">Gemeinsame Grundlage</p>
        <h2>Was ihr mittragen solltet</h2>
        <ul class="editorial-list">
          <li>
            Entwicklung und Tempo des Kindes haben Vorrang vor einem vorgegebenen Notenschnitt,
            Abschlusszeitpunkt oder Karriereweg.
          </li>
          <li>Freiheit braucht klare Regeln, Mitarbeit und Verantwortung.</li>
          <li>
            Wir begleiten Kinder ohne Druck, Belohnung oder Bestrafung als pädagogische
            Steuerungsmittel.
          </li>
          <li>Eltern gestalten die Gemeinschaft aktiv mit.</li>
        </ul>
      </article>
    </div>
  </section>

  <ImageSplit
    image={seoPages.kennenlernen.image}
    alt="Ein Kind balanciert auf einer Holzbank und wird von einer zugewandten erwachsenen Begleitperson unterstützt"
    reverse
    light
    portrait
    position="center 35%"
  >
    <p class="eyebrow">Euer erster Eindruck</p>
    <h2>Erlebt erst die Haltung. Entscheidet dann.</h2>
    <p>
      Infoabend, Tag der offenen Tür, Hospitation und persönliche Gespräche machen Montessori
      konkret. Ihr erlebt, wie Erwachsene begleiten, wie Freiheit und Grenzen zusammengehören und
      welche Rolle Eltern in unserer Gemeinschaft haben.
    </p>
    <TextLink href="/termine/" label="Aktuelle Termine" />
  </ImageSplit>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Alle Informationen</p>
        <h2>Euer Weg in die Monte.</h2>
      </div>
      <div class="hub-links">
        <HubLink
          href="/kennenlernen/aufnahme-kindergarten/"
          title="Aufnahme Kindergarten"
          description="Kennenlernen, Aufnahmebogen, Hospitation und persönliche Entscheidung – mit Blick auf den langfristigen Weg in der Monte."
        />
        <HubLink
          href="/kennenlernen/aufnahme-schule/"
          title="Aufnahme Schule"
          description="Der Ablauf für die Einschulung in Klasse 1. Quereinstiege werden nur in begründeten Einzelfällen geprüft."
        />
        <HubLink
          href="/kennenlernen/kosten/"
          title="Kosten & Mitarbeit"
          description="Schulgeld, Kindergartenbeitrag, Elterneinlage, Vereinsbeitrag und die verbindliche Mitarbeit transparent erklärt."
        />
        <HubLink
          href="/kennenlernen/haeufige-fragen/"
          title="Häufige Fragen"
          description="Von Noten und Abschlüssen über Grenzen bis zur Frage, was passiert, wenn ein Kind nicht arbeiten möchte."
        />
      </div>
    </div>
  </section>

  <CTASection
    title="Lernt uns in Ruhe kennen."
    text="Schaut euch die nächsten Termine an oder meldet euch beim Kindergarten beziehungsweise Schulbüro. Wir klären gemeinsam, welcher nächste Schritt sinnvoll ist."
    primaryHref="/termine/"
    primaryLabel="Termine ansehen"
    secondaryHref="/kontakt/"
    secondaryLabel="Kontakt aufnehmen"
  />
</BaseLayout>

<style>
  .introduction-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .introduction-links :global(a) {
    min-height: 44px;
  }

  .fit-columns article {
    padding-top: 2rem;
    border-top: 2px solid var(--color-action);
  }
</style>
