---
import "@/styles/job-posting.css";
import { Check } from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTASection from "@/components/CTASection.astro";
import { getJobs, getWebsiteSettings, type Job } from "@/data/content";
import { formatGermanLongDate } from "@/data/content-utils";
import { createJobPosting } from "@/data/job-posting";
import { createJobSeo } from "@/data/job-seo";
import { getSeoLayoutProps } from "@/data/seo";

export async function getStaticPaths() {
  const jobs = await getJobs();
  return jobs.map((job) => ({ params: { slug: job.slug }, props: { job } }));
}

interface Props {
  job: Job;
}

const { job } = Astro.props;
const { contact } = await getWebsiteSettings();
const mailSubject = encodeURIComponent(`Bewerbung: ${job.title}`);
const jobPosting = createJobPosting(job, contact.address);
const jobSeo = createJobSeo(job);
---

<BaseLayout {...getSeoLayoutProps(jobSeo)} additionalStructuredData={[jobPosting]}>
  <section class="job-hero">
    <div class="container">
      <p class="eyebrow">{job.areaLabel}</p>
      <h1 class="job-text">{job.title}</h1>
      <div class="job-hero__meta">
        <p class="lead job-text">{job.intro}</p>
        <div class="job-hero__facts">
          <span>{job.scheduleLabel}</span>
          <time datetime={job.datePosted}
            >Veröffentlicht am {formatGermanLongDate(job.datePosted)}</time
          >
        </div>
      </div>
    </div>
  </section>

  <section class="section job-about">
    <div class="container grid-2">
      <div><p class="eyebrow">Über uns</p><h2>Ein Ort für eigenständiges Lernen.</h2></div>
      <div class="job-about__copy">
        {job.about.map((paragraph) => <p class="job-text">{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2 job-content">
      <div>
        <p class="eyebrow">Deine Aufgabe</p>
        <h2>Was du bei uns gestaltest.</h2>
        <ul class="job-checks">
          {
            job.responsibilities.map((item) => (
              <li>
                <Check size={19} aria-hidden="true" />
                <span class="job-text">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="eyebrow">Dein Profil</p>
        <h2>Was du mitbringst.</h2>
        <ul class="job-checks">
          {
            job.profile.map((item) => (
              <li>
                <Check size={19} aria-hidden="true" />
                <span class="job-text">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container grid-2">
      <div>
        <p class="eyebrow">Wir bieten</p><h2>Was dich bei uns erwartet.</h2>
      </div>
      <div>
        <ul class="editorial-list">
          {job.benefits.map((item) => <li class="job-text">{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <div class="job-application">
    <CTASection
      eyebrow="Interesse?"
      title={job.closingTitle}
      text={job.closingText}
      primaryHref={`mailto:${contact.careersEmail}?subject=${mailSubject}`}
      primaryLabel="Per E-Mail bewerben"
      primaryRevealLabel="Bewerbungsadresse anzeigen"
      secondaryHref={`mailto:${contact.careersEmail}?subject=${encodeURIComponent(`Kennenlernen: ${job.title}`)}`}
      secondaryLabel="Erst kennenlernen"
    />
  </div>
</BaseLayout>
